# Cached raw downloads (re-fetch via scripts)
**/.cache/

# Python
**/__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
.idea/
.vscode/

# Built dataset. This repo carries the builders and a dev sample per package, not the
# corpus — a full build is hundreds of MB and is reproduced by running the scripts.
# The assembled corpus lives outside the repo (see cpt_corpus/).
**/output/*.jsonl
**/output/*.log

# Rendered inspection pages. These embed the record text verbatim, so committing one
# would put corpus prose back into the repo through a different file extension — the
# same content the rule above keeps out. Regenerate locally with the render script.
**/output/*.html

**/NOTION_PAGE.md

# Stale raw XML left in 41_wasde/data — the builder downloads its own copies into
# .cache/reports from the ESMIS API and never reads data/. (07_cdc_fluview/data is a
# real build input, declared as csv_dir in its config, and stays tracked.)
41_wasde/data/
