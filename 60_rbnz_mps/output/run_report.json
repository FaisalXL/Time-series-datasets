        },
        "2.15": {
          "unit_prefix": "inflation",
          "cols": [
            "Headline",
            "Non-tradables",
            "Tradables"
          ]
        },
        "2.1": {
          "unit": "production_gdp_real_2009_10_nzd_bn",
          "cols": null
        },
        "3.10": {
          "unit": "twi_index",
          "cols": null,
          "daily": true
        }
      }
    },
    "variables": [
      {
        "name": "ocr_pct",
        "title_pattern": "official cash rate|\\bOCR\\b",
        "exclude_pattern": "expectation|survey|forecast error"
      },
      {
        "name": "inflation_headline",
        "title_pattern": "CPI inflation|consumer price inflation|headline inflation|\\bCPI\\b",
        "exclude_pattern": "tradable|expectation|component"
      },
      {
        "name": "inflation_non_tradables",
        "title_pattern": "non-?tradables? inflation|non-?tradables"
      },
      {
        "name": "inflation_tradables",
        "title_pattern": "(?<!non-)(?<!non )tradables? inflation"
      },
      {
        "name": "unemployment_rate_pct",
        "title_pattern": "unemployment"
      },
      {
        "name": "gdp_growth_pct",
        "title_pattern": "\\bGDP\\b|gross domestic product|economic growth",
        "exclude_pattern": "trading partner|world|global|per capita"
      },
      {
        "name": "twi_index",
        "title_pattern": "\\bTWI\\b|trade[- ]weighted"
      },
      {
        "name": "ninety_day_rate_pct",
        "title_pattern": "90[- ]day|ninety[- ]day|bank bill"
      }
    ],
    "text": {
      "min_chars": 300,
      "max_chars": 2500,
      "drop_on_superlative_contradiction": true,
      "narrative_anchors": [
        "^Policy assessment",
